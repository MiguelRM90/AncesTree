    "format": "prettier --write \"**/*.{js,css,html,json,md}\""
  },
  "devDependencies": {
    "@open-wc/testing": "4.0.0",
    "@web/test-runner": "0.19.0",
    "eslint": "9.15.0",
    "eslint-plugin-wc": "2.2.0",
    "prettier": "3.3.3",
    "vite": "5.4.11"
  },
  "dependencies": {}
}
