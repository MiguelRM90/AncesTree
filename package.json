{
  "name": "ancestree",
  "version": "0.1.0",
  "description": "A family tree that lives on your own computer. No backend, no accounts.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
